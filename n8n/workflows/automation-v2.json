    {
      "id": "gemini-category-selector",
      "name": "Gemini - Category Selector",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        2460,
        140
      ],
      "parameters": {
        "modelId": "models/gemini-flash-latest",
        "messages": {
          "values": [
            {
              "content": "=Choose only from taxonomy slugs.\nTopic: {{ $node['Parse Selector JSON'].json.topic }}\nSummary: {{ $node['Parse Selector JSON'].json.original_summary }}\nTaxonomy: {{ JSON.stringify($json) }}\nOutput JSON:\n{ \"primary_category_slug\":\"\", \"secondary_tag_slugs\":[] }"
            }
          ]
        }
      }
    },
    {
      "id": "validate-category-json",
      "name": "Validate Category JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2680,
        140
      ],
      "parameters": {
        "jsCode": "const raw = $json?.content?.parts?.[0]?.text || '';\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\nif (!parsed.primary_category_slug) throw new Error('primary_category_slug missing');\nif (!Array.isArray(parsed.secondary_tag_slugs)) parsed.secondary_tag_slugs = [];\nparsed.secondary_tag_slugs = parsed.secondary_tag_slugs.slice(0,2);\nreturn [{ json: parsed }];"
      }
    },
    {
      "id": "gemini-writer",
      "name": "Gemini - Writer",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        2900,
        140
      ],
      "parameters": {
        "modelId": "models/gemini-pro-latest",
        "messages": {
          "values": [
            {
              "content": "=Write a 600-700 word technical HTML fragment.\nTopic: {{ $node['Parse Selector JSON'].json.topic }}\nSource Summary: {{ $node['Parse Selector JSON'].json.original_summary }}\nSource Link: {{ $node['Parse Selector JSON'].json.source_link }}"
            }
          ]
        }
      }
    },
    {
      "id": "gemini-translator",
      "name": "Gemini - Translator",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        3120,
        140
      ],
      "parameters": {
        "modelId": "models/gemini-flash-latest",
        "messages": {
          "values": [
            {
              "content": "=Translate to Turkish. Keep HTML structure exactly.\n{{ $json.content?.parts?.[0]?.text || $json.text }}"
            }
          ]
        }
      }
    },
    {
      "id": "extract-headings",
      "name": "Extract First 2 Headings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3340,
        140
      ],
      "parameters": {
        "jsCode": "const html = $node['Gemini - Writer'].json.content.parts[0].text;\nconst matches = [...html.matchAll(/<h2[^>]*>(.*?)<\\/h2>/gi)].map(m => m[1].replace(/<[^>]+>/g,'').trim());\nreturn [{ json: { heading_1: matches[0] || 'Main topic', heading_2: matches[1] || 'Technical details' } }];"
      }
    },
    {
      "id": "gemini-image-1",
      "name": "Gemini - Image 1",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        3560,
        30
      ],
      "parameters": {
        "modelId": "models/gemini-2.5-flash-image-preview",
        "messages": {
          "values": [
            {
              "content": "=Generate a clean editorial image for: {{ $json.heading_1 }}. Return image as base64 only."
            }
          ]
        }
