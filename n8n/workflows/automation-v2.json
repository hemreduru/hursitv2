        "url": "https://www.hursit.me/api/posts/automated",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"title_en\": $json.title_en,\n  \"title_tr\": $json.title_tr,\n  \"short_description_en\": $json.content_en.replace(/<[^>]+>/g, '').substring(0,160),\n  \"short_description_tr\": $json.content_tr.replace(/<[^>]+>/g, '').substring(0,160),\n  \"content_en\": $json.content_en,\n  \"content_tr\": $json.content_tr,\n  \"status\": \"published\",\n  \"thumbnail\": $json.thumbnail,\n  \"source_url\": $json.source_url,\n  \"primary_category_slug\": $json.primary_category_slug,\n  \"secondary_tag_slugs\": $json.secondary_tag_slugs\n} }}"
      }
    },
