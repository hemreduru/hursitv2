    {
      "id": "inject-inline-images",
      "name": "Inject Inline Images",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4000,
        140
      ],
      "parameters": {
        "jsCode": "const contentEn = $node['Gemini - Writer'].json.content.parts[0].text;\nconst contentTr = $node['Gemini - Translator'].json.content.parts[0].text;\nconst image1 = $node['Upload Image 1'].json.url || '';\nconst image2 = $node['Upload Image 2'].json.url || '';\nconst img1 = image1 ? `<p><img src=\"${image1}\" alt=\"generated image\" loading=\"lazy\"></p>` : '';\nconst img2 = image2 ? `<p><img src=\"${image2}\" alt=\"generated image\" loading=\"lazy\"></p>` : '';\nconst withFirst = contentEn.replace(/(<h2[^>]*>.*?<\\/h2>)/i, `$1${img1}`);\nconst withSecond = withFirst.replace(/(<h2[^>]*>.*?<\\/h2>)([\\s\\S]*?<h2[^>]*>.*?<\\/h2>)/i, `$1$2${img2}`);\nconst withFirstTr = contentTr.replace(/(<h2[^>]*>.*?<\\/h2>)/i, `$1${img1}`);\nconst withSecondTr = withFirstTr.replace(/(<h2[^>]*>.*?<\\/h2>)([\\s\\S]*?<h2[^>]*>.*?<\\/h2>)/i, `$1$2${img2}`);\nreturn [{ json: { content_en: withSecond, content_tr: withSecondTr, thumbnail: image1 } }];"
      }
    },
    {
      "id": "prepare-post-payload",
      "name": "Prepare Post Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        4220,
        140
      ],
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "title_en",
              "value": "={{ $node['Gemini - Writer'].json.content.parts[0].text.split('\\n').find(l => l.trim().startsWith('<h2>'))?.replace(/<[^>]+>/g,'') || 'Untitled' }}"
            },
            {
              "name": "title_tr",
              "value": "={{ $node['Gemini - Translator'].json.content.parts[0].text.split('\\n').find(l => l.trim().startsWith('<h2>'))?.replace(/<[^>]+>/g,'') || 'Basliksiz' }}"
            },
            {
              "name": "content_en",
              "value": "={{ $node['Inject Inline Images'].json.content_en }}"
            },
            {
              "name": "content_tr",
              "value": "={{ $node['Inject Inline Images'].json.content_tr }}"
            },
            {
              "name": "thumbnail",
              "value": "={{ $node['Inject Inline Images'].json.thumbnail }}"
            },
            {
              "name": "source_url",
              "value": "={{ $node['Parse Selector JSON'].json.source_link }}"
            },
            {
              "name": "primary_category_slug",
              "value": "={{ $node['Validate Category JSON'].json.primary_category_slug }}"
            }
          ],
          "json": [
            {
              "name": "secondary_tag_slugs",
              "value": "={{ $node['Validate Category JSON'].json.secondary_tag_slugs }}"
            }
          ]
        }
      }
    },
