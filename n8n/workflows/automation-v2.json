    {
      "id": "rss-links",
      "name": "RSS Links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [\n  { json: { url: \"https://feed.laravel-news.com/\" } },\n  { json: { url: \"https://dev.to/feed/tag/devops\" } }\n];"
      }
    },
    {
      "id": "rss-to-json",
      "name": "RSS to JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "https://api.rss2json.com/v1/api.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "rss_url",
              "value": "={{ $json.url }}"
            }
          ]
        }
      }
    },
    {
      "id": "merge-rss-data",
      "name": "Merge RSS Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "let news = \"\";\nitems.forEach(i => {\n  (i.json.items || []).slice(0,5).forEach(p => {\n    const clean = (p.description || '').replace(/<[^>]+>/g,'').substring(0,300);\n    news += `--- NEWS ITEM ---\\nTitle: ${p.title}\\nLink: ${p.link}\\nSummary: ${clean}\\n\\n`;\n  });\n});\nreturn [{ json: { news_context: news || 'No news found' } }];"
      }
    },
    {
      "id": "gemini-selector",
      "name": "Gemini - Selector",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        900,
        0
      ],
      "parameters": {
        "modelId": "models/gemini-flash-latest",
        "messages": {
          "values": [
            {
              "content": "=Select ONLY ONE most important Laravel or DevOps news from below and return raw JSON.\n\n{{ $json.news_context }}\n\nFormat:\n{ \"topic\":\"\", \"category\":\"\", \"source_link\":\"\", \"original_summary\":\"\" }"
            }
          ]
        }
      }
    },
    {
      "id": "parse-selector-json",
      "name": "Parse Selector JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $json?.content?.parts?.[0]?.text || '';\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nreturn [{ json: JSON.parse(cleaned) }];"
      }
    },
    {
      "id": "get-dedupe-context",
      "name": "Get Dedupe Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1360,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.hursit.me/api/automation/dedupe-context",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "180"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        }
      }
    },
    {
      "id": "gemini-duplicate-judge",
      "name": "Gemini - Duplicate Judge",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        1580,
        0
      ],
      "parameters": {
        "modelId": "models/gemini-flash-latest",
        "messages": {
          "values": [
            {
              "content": "=Given candidate topic and published history, decide duplicate risk. Return JSON only.\nCandidate Topic: {{ $node['Parse Selector JSON'].json.topic }}\nCandidate Source: {{ $node['Parse Selector JSON'].json.source_link }}\nHistory: {{ JSON.stringify($json.items || []) }}\nOutput:\n{ \"is_duplicate\": false, \"score\": 0.0, \"matched_post_id\": null, \"reason\": \"\" }"
            }
          ]
        }
      }
    },
    {
      "id": "parse-duplicate-json",
      "name": "Parse Duplicate JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $json?.content?.parts?.[0]?.text || '';\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\nreturn [{ json: parsed }];"
      }
    },
    {
      "id": "if-duplicate",
      "name": "IF Duplicate >= 0.78",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2020,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_duplicate === true && Number($json.score || 0) >= 0.78 }}"
            }
          ]
        }
      }
    },
    {
      "id": "telegram-duplicate-skip",
      "name": "Telegram Duplicate Skip",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2240,
        -120
      ],
      "parameters": {
        "chatId": "5679822050",
        "text": "=⏭️ Duplicate skipped. score={{ $json.score }} reason={{ $json.reason }}"
